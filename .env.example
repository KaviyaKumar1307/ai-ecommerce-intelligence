# ==============================================================
# AI-Powered E-Commerce Intelligence System - Environment Config
# ==============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=supersecret_ecommerce_ai_jwt_key_2026
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Database Configuration (MySQL / SQLite Dual-Support)
# DB_DIALECT: 'mysql' for production MySQL server, 'sqlite' for zero-config local testing
DB_DIALECT=sqlite
DB_STORAGE=./database/ecommerce.sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_ecommerce
DB_USER=root
DB_PASSWORD=rootpassword

# AI Service Configuration (FastAPI Python Service)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=6000

# Frontend Configuration (used by Vite frontend)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_AI_SERVICE_URL=http://localhost:8000
